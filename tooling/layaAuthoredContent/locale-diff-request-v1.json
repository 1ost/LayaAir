{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layaair.com/tooling/laya-authored-content-locale-diff-request-v1",
  "title": "LayaAir authored-content locale diff request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "locale", "baseCatalog", "bundles"],
  "properties": {
    "schema": { "const": "laya-authored-content-locale-diff-request@1" },
    "id": { "$ref": "#/$defs/stableString" },
    "locale": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)+$" },
    "baseCatalog": { "$ref": "#/$defs/catalogReference" },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle", "base", "localized"],
        "properties": {
          "bundle": { "$ref": "#/$defs/stableString" },
          "base": { "$ref": "#/$defs/relativePath" },
          "localized": { "$ref": "#/$defs/relativePath" },
          "imageBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["resourceId", "assetId", "path"],
              "properties": {
                "resourceId": { "$ref": "#/$defs/stableString" },
                "assetId": { "$ref": "#/$defs/stableString" },
                "path": { "$ref": "#/$defs/relativePath" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stableString": {
      "type": "string",
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*\\u0000)[\\s\\S]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f:])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "catalogReference": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\\\?#])(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))[\\s\\S]*\\.runtime-catalog\\.json$"
    }
  }
}
