{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layaair.com/tooling/laya-authored-content-project-v1",
  "title": "LayaAir authored-content tooling project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "jobs"],
  "properties": {
    "schema": { "const": "laya-authored-content-project@1" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "packageVersion", "remote", "capabilityLedger"],
      "properties": {
        "repository": { "const": "LayaAir" },
        "commit": { "$ref": "#/$defs/gitOid" },
        "packageVersion": { "$ref": "#/$defs/stableString" },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "ref", "commit"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
            "url": { "$ref": "#/$defs/stableString" },
            "ref": { "$ref": "#/$defs/remoteRef" },
            "commit": { "$ref": "#/$defs/gitOid" }
          }
        },
        "capabilityLedger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "schema", "hashMode", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "schema": { "const": "laya-authored-content-capabilities@1" },
            "hashMode": { "const": "canonical-lf-utf8" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "entries", "locales", "output", "requiredCapabilities"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "sha256", "size"],
            "properties": {
              "kind": { "enum": ["raw-swf", "raw-swc", "evidence-bundle", "neutral-ir"] },
              "path": { "$ref": "#/$defs/relativePath" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            }
          },
          "entries": { "$ref": "#/$defs/nonemptyIds" },
          "locales": { "$ref": "#/$defs/ids" },
          "output": { "$ref": "#/$defs/relativePath" },
          "requiredCapabilities": { "$ref": "#/$defs/ids" }
        }
      }
    }
  },
  "$defs": {
    "stableString": {
      "type": "string",
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*\\u0000)[\\s\\S]+$"
    },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "remoteRef": {
      "type": "string",
      "pattern": "^refs/remotes/[A-Za-z0-9][A-Za-z0-9._-]*/(?![\\s\\S]*\\.\\.)(?![\\s\\S]*\\u0000)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f:])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nonemptyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$comment": "The scalar and structural constraints are identical to the runtime validator. The runtime additionally enforces constraints JSON Schema cannot express: remote.ref belongs to remote.name, job IDs are unique, and NFC/case-folded output identities do not overlap. Arrays are canonicalized by the runtime before hashing."
}
