{
  "name": "layaair",
  "version": "3.4.0",
  "description": "LayaAir3.4 Engine",
  "main": "layaAir.config.js",
  "scripts": {
    "start": "npm-run-all clean copyShaders copyJsLibs --parallel watchShaders watchSamples",
    "build": "npm run check:authored-content-admission && npm run verify:authored-content-capabilities && node scripts/buildEngine.mjs",
    "buildSamples": "node scripts/buildSamples.mjs",
    "esbuildSamplesWebGL": "node scripts/watchSamples.mjs webgl",
    "esbuildSamplesWebGPU": "node scripts/watchSamples.mjs webgpu",
    "buildApi": "node scripts/buildApiDoc.mjs",
    "watchShaders": "copy-and-watch --skip-initial-copy --watch src/**/*.{glsl,vs,fs} bin/tsc/",
    "watchSamples": "cd ./src/samples && tsc -b --force --watch",
    "clean": "rimraf ./bin/tsc",
    "copyShaders": "copyfiles -u 1 ./src/**/*.{glsl,vs,fs} ./bin/tsc/",
    "copyJsLibs": "copyfiles -s -u 2 ./src/layaAir/jsLibs/**/* ./bin/",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "buildDocTool": "cd ./docTool && tsc",
    "buildDocToolRun": "node ./docTool/dist/index.js",
    "check:authored-content-admission": "node scripts/checkAuthoredContentAdmission.mjs",
    "test:authored-content-admission": "node --test tests/architecture/authoredContentAdmission.test.mjs",
    "verify:authored-content-capabilities": "node scripts/checkAuthoredContentAdmission.mjs --verify-evidence",
    "check:authored-content-hashes": "node scripts/updateAuthoredContentHashes.mjs --check",
    "test:websocket": "node scripts/testWebSocketCore.mjs",
    "test:websocket:types": "tsc -p tests/net/tsconfig.json --pretty false",
    "test:authored-image-publish": "node --experimental-strip-types --test tests/authoredImagePublish/authored-image-publish.test.mjs",
    "authored-pixel-golden": "node scripts/authoredPixelGolden.mjs",
    "test:authored-pixel-golden": "node --test tests/authoredPixelGolden/authored-pixel-golden.test.mjs",
    "build:authored-content": "npm --prefix src/extensions/authoredContent run build",
    "build:authored-content-tooling": "node src/extensions/authoredContent/scripts/buildTooling.mjs",
    "test:authored-content": "npm --prefix src/extensions/authoredContent run test",
    "test:authored-content-tooling": "npm run build:authored-content-tooling && node --test tests/authoredContentTooling/*.test.mjs",
    "test:authored-bridge": "node scripts/testAuthoredContentBridge.mjs",
    "test:authored-bridge:types": "tsc -p tests/extensions/authoredContentBridge/tsconfig.json --pretty false",
    "test:flash-filters": "node scripts/testFlashFilters.mjs",
    "test:flash-filters:types": "tsc -p tests/flashFilters/tsconfig.json --pretty false",
    "test:flash-filters:gpu": "node scripts/testFlashFiltersGpu.mjs",
    "test:flash-geometry": "node scripts/testFlashGeometry.mjs",
    "test:flash-geometry:types": "tsc -p tests/flashGeometry/tsconfig.json --pretty false",
    "test:flash-geometry:gpu": "node scripts/testFlashGeometryGpu.mjs",
    "test:flash-timer": "node scripts/testFlashTimer.mjs",
    "test:flash-timer:types": "tsc -p tests/flashTimer/tsconfig.json --pretty false",
    "test:flash-timer:declarations": "node --test tests/flashTimer/flash-timer.declarations.test.mjs",
    "test:flash-byte-array": "node scripts/testFlashByteArray.mjs",
    "test:flash-byte-array:types": "tsc -p tests/flashByteArray/tsconfig.json --pretty false",
    "test:flash-loader": "node scripts/testFlashLoader.mjs",
    "test:flash-loader:types": "tsc -p tests/flashLoader/tsconfig.json --pretty false",
    "test:flash-display-root": "node scripts/testFlashDisplayRoot.mjs",
    "test:flash-display-root:types": "tsc -p tests/flashDisplayRoot/tsconfig.json --pretty false",
    "test:flash-global-errors": "node scripts/testFlashGlobalErrors.mjs",
    "test:flash-global-errors:types": "tsc -p tests/flashGlobalErrors/tsconfig.json --pretty false",
    "buildCanver": "npm run buildDocTool && npm run buildDocToolRun"
  },
  "author": "Layabox Inc.",
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@shipgirl/typedoc-plugin-versions": "^0.3.0",
    "@types/node": "^20.12.7",
    "@webgpu/types": "^0.1.60",
    "conventional-changelog-cli": "^2.2.2",
    "copy-and-watch": "^0.1.6",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.25.0",
    "glob": "^11.0.0",
    "husky": "^8.0.2",
    "minigame-api-typings": "^3.8.11",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "rollup": "^2.74.0",
    "rollup-plugin-glsl": "^1.3.0",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-typescript2": "^0.21.2",
    "ts-morph": "^24.0.0",
    "typedoc": "^0.26.0",
    "typescript": "^4.9.5",
    "webgpu": "^0.1.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/layabox/LayaAir"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dpdm": "^3.14.0",
    "i18next": "^23.11.2",
    "rollup-plugin-esbuild": "^6.2.1"
  },
  "bugs": {
    "url": "https://ask.layaAir.com/"
  }
}
