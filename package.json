{
  "name": "layaair",
  "version": "3.4.0",
  "description": "LayaAir3.4 Engine",
  "main": "layaAir.config.js",
  "scripts": {
    "start": "npm-run-all clean copyShaders copyJsLibs --parallel watchShaders watchSamples",
    "build": "npm run check:authored-content-admission && npm run verify:authored-content-capabilities && node scripts/buildEngine.mjs",
    "buildSamples": "node scripts/buildSamples.mjs",
    "esbuildSamplesWebGL": "node scripts/watchSamples.mjs webgl",
    "esbuildSamplesWebGPU": "node scripts/watchSamples.mjs webgpu",
    "buildApi": "node scripts/buildApiDoc.mjs",
    "watchShaders": "copy-and-watch --skip-initial-copy --watch src/**/*.{glsl,vs,fs} bin/tsc/",
    "watchSamples": "cd ./src/samples && tsc -b --force --watch",
    "clean": "rimraf ./bin/tsc",
    "copyShaders": "copyfiles -u 1 ./src/**/*.{glsl,vs,fs} ./bin/tsc/",
    "copyJsLibs": "copyfiles -s -u 2 ./src/layaAir/jsLibs/**/* ./bin/",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "buildDocTool": "cd ./docTool && tsc",
    "buildDocToolRun": "node ./docTool/dist/index.js",
    "check:authored-content-admission": "node scripts/checkAuthoredContentAdmission.mjs",
    "test:authored-content-admission": "node --test tests/architecture/authoredContentAdmission.test.mjs",
    "verify:authored-content-capabilities": "node scripts/updateAuthoredContentHashes.mjs --check && node scripts/checkAuthoredContentAdmission.mjs --verify-evidence",
    "check:authored-content-hashes": "node scripts/updateAuthoredContentHashes.mjs --check",
    "test:authored-content-hash-updater": "node --test tests/architecture/authoredContentHashUpdater.test.mjs",
    "test:websocket": "node scripts/testWebSocketCore.mjs",
    "test:websocket:types": "tsc -p tests/net/tsconfig.json --pretty false",
    "test:flash-net": "node scripts/testFlashNet.mjs",
    "test:flash-net:types": "tsc -p tests/flashNet/tsconfig.json --pretty false",
    "test:flash-net:declarations": "node --test tests/flashNet/flash-net.declarations.test.mjs",
    "test:flash-media": "node scripts/testFlashMedia.mjs",
    "test:flash-media:types": "tsc -p tests/flashMedia/tsconfig.json --pretty false",
    "test:authored-image-publish": "node --experimental-strip-types --test tests/authoredImagePublish/authored-image-publish.test.mjs",
    "test:authored-projected-bitmap-fill": "node --max-old-space-size=512 tests/authoredProjectedBitmapFill/run.cjs",
    "test:authored-library-symbol-projection": "node --max-old-space-size=512 tests/authoredLibrarySymbolProjection/run.cjs",
    "test:authored-flash-display-list-timeline": "node --max-old-space-size=512 tests/authoredFlashDisplayListTimeline/run.cjs",
    "test:authored-movieclip-timeline-runtime": "node --max-old-space-size=512 scripts/testFlashMovieClipFrameScripts.mjs",
    "test:authored-movieclip-timeline:types": "tsc -p tests/flashMovieClipFrameScripts/tsconfig.json --pretty false",
    "test:authored-flash-button-projection": "node --max-old-space-size=512 tests/authoredFlashButtonProjection/run.cjs",
    "test:authored-flash-button-runtime": "node scripts/testAuthoredFlashButtonRuntime.mjs",
    "test:authored-flash-button-runtime:types": "tsc -p tests/authoredFlashButtonRuntime/tsconfig.json --pretty false",
    "test:authored-bundle-asset-identity": "node --max-old-space-size=512 tests/authoredBundleAssetIdentity/run.cjs",
    "test:authored-scale9-grid": "node scripts/testAuthoredScale9Grid.mjs",
    "authored-pixel-golden": "node scripts/authoredPixelGolden.mjs",
    "test:authored-pixel-golden": "node --test tests/authoredPixelGolden/authored-pixel-golden.test.mjs",
    "build:authored-content": "npm --prefix src/extensions/authoredContent run build",
    "build:authored-content-tooling": "node src/extensions/authoredContent/scripts/buildTooling.mjs",
    "test:authored-content": "npm --prefix src/extensions/authoredContent run test",
    "test:authored-content-tooling": "npm run build:authored-content-tooling && node --test tests/authoredContentTooling/*.test.mjs",
    "test:authored-bridge": "node --max-old-space-size=768 scripts/testAuthoredContentBridge.mjs",
    "test:authored-bridge:types": "tsc -p tests/extensions/authoredContentBridge/tsconfig.json --pretty false",
    "test:authored-font-registry": "node scripts/testAuthoredFontRegistry.mjs",
    "test:authored-embedded-font": "node --max-old-space-size=512 tests/authoredEmbeddedFont/run.cjs",
    "test:authored-restricted-html": "node scripts/testAuthoredRestrictedHtmlText.mjs",
    "test:authored-font-registry:types": "tsc -p tests/authoredFontRegistry/tsconfig.json --pretty false",
    "test:flash-filters": "node scripts/testFlashFilters.mjs",
    "test:flash-filters:types": "tsc -p tests/flashFilters/tsconfig.json --pretty false",
    "test:flash-filters:gpu": "node scripts/testFlashFiltersGpu.mjs",
    "test:flash-filters:declarations": "node --test tests/flashFilters/flash-filters.declarations.test.mjs",
    "test:flash-geometry": "node scripts/testFlashGeometry.mjs",
    "test:flash-geometry:types": "tsc -p tests/flashGeometry/tsconfig.json --pretty false",
    "test:flash-geometry:gpu": "node scripts/testFlashGeometryGpu.mjs",
    "test:flash-timer": "node scripts/testFlashTimer.mjs",
    "test:flash-timer:types": "tsc -p tests/flashTimer/tsconfig.json --pretty false",
    "test:flash-timer:declarations": "node --test tests/flashTimer/flash-timer.declarations.test.mjs",
    "test:flash-events": "node scripts/testFlashEvents.mjs",
    "test:flash-events:types": "tsc -p tests/flashEvents/tsconfig.json --pretty false",
    "test:flash-byte-array": "node scripts/testFlashByteArray.mjs",
    "test:flash-byte-array:types": "tsc -p tests/flashByteArray/tsconfig.json --pretty false",
    "test:flash-trace": "node --experimental-strip-types --test tests/flashTrace/flash-trace.test.ts",
    "test:flash-reflection": "node scripts/testFlashReflection.mjs",
    "test:flash-reflection:types": "tsc -p tests/flashReflection/tsconfig.json --pretty false",
    "test:flash-application-domain": "node --max-old-space-size=512 scripts/testFlashApplicationDomain.mjs",
    "test:flash-application-domain:types": "tsc -p tests/flashApplicationDomain/tsconfig.json --pretty false",
    "test:flash-utils-dispositions": "node --test tests/architecture/flashUtilsSourceDisposition.test.mjs",
    "test:flash-loader": "node --max-old-space-size=512 scripts/testFlashLoader.mjs",
    "test:flash-loader:types": "tsc -p tests/flashLoader/tsconfig.json --pretty false",
    "test:flash-display-object": "node --max-old-space-size=512 scripts/testFlashDisplayObject.mjs",
    "test:flash-display-object:types": "tsc -p tests/flashDisplayObject/tsconfig.json --pretty false",
    "test:flash-movie-clip-frame-scripts": "node --max-old-space-size=512 scripts/testFlashMovieClipFrameScripts.mjs",
    "test:flash-movie-clip-frame-scripts:types": "tsc -p tests/flashMovieClipFrameScripts/tsconfig.json --pretty false",
    "test:flash-display-root": "node scripts/testFlashDisplayRoot.mjs",
    "test:flash-display-root:types": "tsc -p tests/flashDisplayRoot/tsconfig.json --pretty false",
    "test:flash-stage": "node --max-old-space-size=512 scripts/testFlashStage.mjs",
    "test:flash-stage:types": "tsc -p tests/flashStage/tsconfig.json --pretty false",
    "test:flash-stage:browser": "node scripts/testFlashStageBrowser.mjs",
    "test:flash-global-errors": "node scripts/testFlashGlobalErrors.mjs",
    "test:flash-global-errors:types": "tsc -p tests/flashGlobalErrors/tsconfig.json --pretty false",
    "test:flash-strict-xml": "node scripts/testFlashStrictXml.mjs",
    "test:flash-strict-xml:types": "tsc -p tests/flashStrictXml/tsconfig.json --pretty false",
    "test:flash-strict-xml:declarations": "node --test tests/flashStrictXml/flash-strict-xml.declarations.test.mjs",
    "test:flash-xml": "node --max-old-space-size=512 scripts/testFlashXml.mjs",
    "test:flash-xml:types": "tsc -p tests/flashXml/tsconfig.json --pretty false",
    "test:flash-proxy": "node --max-old-space-size=512 scripts/testFlashProxy.mjs",
    "test:flash-proxy:types": "tsc -p tests/flashProxy/tsconfig.json --pretty false",
    "test:flash-system-host": "node scripts/testFlashSystemHost.mjs",
    "test:flash-system-host:types": "tsc -p tests/flashSystemHost/tsconfig.json --pretty false",
    "test:flash-system-host:declarations": "node --test tests/flashSystemHost/flash-system-host.declarations.test.mjs",
    "test:flash-system-host:public-root": "tsc -p tests/flashSystemHost/tsconfig.public-root.json --pretty false",
    "test:flash-system-host:bundle": "node scripts/testFlashSystemHostBundle.mjs",
    "test:flash-ui-host": "node scripts/testFlashUiHost.mjs",
    "test:flash-ui-host:types": "tsc -p tests/flashUiHost/tsconfig.json --pretty false",
    "test:flash-ui-host:declarations": "node --test tests/flashUiHost/flash-ui-host.declarations.test.mjs",
    "buildCanver": "npm run buildDocTool && npm run buildDocToolRun"
  },
  "author": "Layabox Inc.",
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@shipgirl/typedoc-plugin-versions": "^0.3.0",
    "@types/node": "^20.12.7",
    "@webgpu/types": "^0.1.60",
    "conventional-changelog-cli": "^2.2.2",
    "copy-and-watch": "^0.1.6",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.25.0",
    "glob": "^11.0.0",
    "husky": "^8.0.2",
    "minigame-api-typings": "^3.8.11",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "rollup": "^2.74.0",
    "rollup-plugin-glsl": "^1.3.0",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-typescript2": "^0.21.2",
    "ts-morph": "^24.0.0",
    "typedoc": "^0.26.0",
    "typescript": "^4.9.5",
    "webgpu": "^0.1.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/layabox/LayaAir"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dpdm": "^3.14.0",
    "i18next": "^23.11.2",
    "rollup-plugin-esbuild": "^6.2.1"
  },
  "bugs": {
    "url": "https://ask.layaAir.com/"
  }
}
